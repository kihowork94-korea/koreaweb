# 어드민 PIN (4자리 숫자)
ADMIN_PIN=1234

# Supabase (로컬 개발용 — supabase start 후 발급되는 값)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=<anon key>
NUXT_SUPABASE_SECRET_KEY=<service_role key>

# 사이트 URL (배포 후 실제 도메인으로 변경)
NUXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Google Analytics (선택)
NUXT_PUBLIC_GA_ID=
